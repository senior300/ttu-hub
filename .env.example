# GEMINI_API_KEY: Required for TTU AI assistant when using Gemini provider.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional alternative AI provider for TTU AI assistant.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# INITIAL_SUPERADMIN_EMAIL: Email address allowed to bootstrap initial SuperAdmin role.
INITIAL_SUPERADMIN_EMAIL="admin@example.ac.ke"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional SMTP email notification configuration
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Optional Cloudinary object storage URL
CLOUDINARY_URL=""
